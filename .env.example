# OPENAI_API_KEY=replace_with_your_api_key
# OPENAI_MODEL=gpt-5.6
# DeepSeek配置
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# PowerAgent API服务配置
POWERAGENT_SERVICE_NAME=PowerAgent
POWERAGENT_SERVICE_VERSION=0.1.0
POWERAGENT_ENV=development
POWERAGENT_API_PREFIX=/api/v1
POWERAGENT_HOST=127.0.0.1
POWERAGENT_PORT=8000

# Docker宿主机暴露端口
POWERAGENT_DOCKER_HOST_PORT=8000

# 日志配置
POWERAGENT_LOG_LEVEL=INFO
POWERAGENT_LOG_DIR=logs

# LLM重试配置
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY=1.0
LLM_RETRY_MAX_DELAY=8.0
LLM_RETRY_JITTER=0.2

# PowerAgent知识库与工作流配置
POWERAGENT_CHROMA_PATH=data/chroma
POWERAGENT_CHROMA_COLLECTION=poweragent_knowledge
POWERAGENT_EMBEDDING_BACKEND=chroma_default
POWERAGENT_HASH_EMBEDDING_DIMENSION=256
POWERAGENT_MAX_REPLANS=1

# PowerAgent知识文档上传配置
POWERAGENT_MAX_UPLOAD_MB=20
POWERAGENT_UPLOAD_TEMP_DIR=data/uploads/tmp
POWERAGENT_DOCUMENT_CHUNK_SIZE=600
POWERAGENT_DOCUMENT_CHUNK_OVERLAP=80